# Settings for the nightly scripts on your server (scripts/*.sh). Copy this folder to overlay/ and edit.
# Each line is KEY=value, read as text and never run. A value already in the environment wins.

# Extra copies of the nightly database backup: folders on other drives or a NAS share, separated by spaces.
COPY_DIRS=/mnt/ssd/memory-backups /mnt/nas/Backups/memory-backups
# Where backup-git.sh copies the bare git repos in ~/git.
GIT_COPY_DIRS=/mnt/ssd/git-backups /mnt/nas/Backups/git-backups
# The name and email on the nightly Markdown export's commits.
EXPORT_GIT_NAME=Brain export
EXPORT_GIT_EMAIL=brain@example.com
# The off-site copy: an rclone remote and folder, and how many days of copies to keep there.
# OFFSITE_REMOTE=gdrive:memory-backups
# OFFSITE_KEEP_DAYS=90
