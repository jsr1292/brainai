# Copy to .env and fill in. .env is never committed (it is in .gitignore) because it holds the tunnel token.
# Lines starting with # are left at their defaults; remove the # to change one.

# --- Required ---------------------------------------------------------------------------------------------------
# The address your apps and browser use. https, except http://localhost while developing.
PUBLIC_URL=https://memory.example.com
# The Cloudflare Tunnel token (Zero Trust › Tunnels › your tunnel). Only the tunnel container sees it.
TUNNEL_TOKEN=
# Your uid and gid on the server (`id -u`, `id -g`): the app runs as them, so ./data stays yours.
PUID=1000
PGID=1000

# --- Your clock ---------------------------------------------------------------------------------------------------
# Days and weeks (the weekly review, "today") follow this zone. UTC when it isn't set.
# OWNER_TIMEZONE=Europe/Berlin

# --- Where things live (the Docker image already sets these) -----------------------------------------------------
# DATA_DIR=./data
# MODEL_DIR=./models
# OVERLAY_DIR=overlay
# PORT=3000
# Address to listen on. The Docker image sets 0.0.0.0 so the tunnel container can reach it; run directly, the
# default 127.0.0.1 keeps it on this machine.
# HOST=127.0.0.1
# Trust the cf-connecting-ip header for the login rate limit. Only safe when the Cloudflare Tunnel is the one way
# in; docker-compose.yml sets it to true because it publishes no port.
# TRUST_CF_CONNECTING_IP=false
# The desktop app: true runs on this computer only (HOST 127.0.0.1, PUBLIC_URL http://localhost:<PORT>), answering only
# to localhost, and signs you in without a password until you set one.
# LOCAL_MODE=false
# Set by the desktop app (at least 32 random characters): its window opens a session with it. Leave unset otherwise.
# APP_SECRET=
# Set by the desktop app: the server stops when the app is gone (its stdin closes). Leave unset otherwise.
# APP_PARENT=
# Set by the desktop app: where Connect finds the coding tools' commands (your login shell's PATH).
# TOOL_PATH=

# --- Personal or work ---------------------------------------------------------------------------------------------
# personal (the shared memory) or work (a separate copy on a work laptop, see docs/WORK.md).
# MEMORY_MODE=personal
# Work mode: a dated copy of the database is written here each day, and the newest BACKUP_KEEP are kept.
# BACKUP_DIR=
# BACKUP_KEEP=14

# --- Discussions ----------------------------------------------------------------------------------------------------
# Lets the assistant that opened a discussion ask the others itself: JSON of connection name to a command with
# {prompt} where the request goes. See docs/WORK.md.
# ASK_COMMANDS={"Codex":"codex exec \"{prompt}\""}

# --- Search tuning (leave alone unless you know why) -------------------------------------------------------------
# How alike two memories must be to count as the same (0 to 1).
# DUPLICATE_THRESHOLD=0.93
# The lowest similarity a recall result may have, how close to the best match it must be, and the level above which
# a match counts as recalled.
# MIN_RECALL_SIMILARITY=0.75
# RECALL_WINDOW=0.015
# RECALL_CONFIDENT_SIMILARITY=0.86
