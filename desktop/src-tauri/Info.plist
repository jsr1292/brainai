<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Merged by Tauri v2 into the generated Info.plist. Without a localisation list macOS tells the web view the app is
       English only, so Accept-Language says en-US even on a Spanish Mac. -->
  <key>CFBundleLocalizations</key>
  <array>
    <string>en</string>
    <string>es</string>
  </array>
</dict>
</plist>
