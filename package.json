{
  "name": "brainai",
  "version": "1.0.1",
  "scripts": {
    "test": "node --import tsx --test --test-concurrency=1 \"src/**/*.test.ts\"",
    "test:model": "RUN_MODEL_TESTS=1 node --import tsx --test src/memory/embedder.model.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && cp -r src/web/static dist/web/",
    "dev": "tsx src/index.ts",
    "cli": "tsx src/cli.ts",
    "demo:seed": "node --import tsx src/scripts/seedDemo.ts",
    "demo:code": "node --import tsx src/scripts/seedDemo.ts --code",
    "model": "node --import tsx src/scripts/warmModel.ts",
    "bench:locomo": "node --import tsx src/scripts/benchLocomo.ts"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@node-rs/argon2": "^2.2.2",
    "better-sqlite3": "13.0.3",
    "diff": "9.0.0",
    "express": "^5.3.0",
    "marked": "18.1.3",
    "qrcode": "^1.5.4",
    "rate-limiter-flexible": "^9.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "dompurify": "3.4.17",
    "mermaid": "12.3.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
